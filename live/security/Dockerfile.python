# The example clients: what an application reads of what the bridge sent, over TLS with a login.
# python-qpid-proton builds from source: a compiler and OpenSSL's headers, or it has no TLS
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev libssl-dev pkg-config \
    && pip install --no-cache-dir paho-mqtt==2.1.0 python-qpid-proton==0.40.0 confluent-kafka==2.6.1 \
    && rm -rf /var/lib/apt/lists/*
COPY python/ /app/
WORKDIR /app
